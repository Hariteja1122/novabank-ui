# Served by the official nginx image. ${API_GATEWAY_URL} is filled in from the
# environment at container start (docker compose or Cloud Run).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Same-origin API calls: the browser never talks to the gateway directly, so no CORS.
    location /api/ {
        proxy_pass ${API_GATEWAY_URL};
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
    }

    # Hashed bundles can be cached forever.
    location ~* \.(js|css|woff2?|svg|png)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Angular routes such as /app/transfer fall back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
